<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>MRedLocal</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets/mundi-mark.ico</ApplicationIcon>
    <Product>MRedLocal</Product>
    <Company>Mundi's Emporium</Company>
    <Copyright>Copyright (c) 2026 Mundi's Emporium</Copyright>
    <Description>Local RedM testing launcher</Description>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../RedMLocalClient/RedMLocalClient.csproj" />
    <ProjectReference Include="../RedMLocalSetup/RedMLocalSetup.csproj" />
    <Resource Include="Assets/*.png" />
    <Content Include="../../adapters/**/*.json;../../adapters/**/*.lua;../../adapters/**/*.patch;../../adapters/**/LICENSE*.txt">
      <Link>adapters/%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>
</Project>
